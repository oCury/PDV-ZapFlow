# Session Secret (change in production)
SESSION_SECRET="ZapFlow_Secret_2026_Auth_Security_Key"

# Mercado Pago - Point Smart Integration
# Single-account token. Also reused as the interim per-tenant fallback (sub-project B)
# until every tenant connects its own MP account via OAuth below.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET=""

# ── Mercado Pago - OAuth / Connect (per-tenant maquininha) ────────────────────
# One MP application for all tenants (marketplace / Connect mode).
MP_OAUTH_CLIENT_ID=""
MP_OAUTH_CLIENT_SECRET=""
MP_OAUTH_REDIRECT_URI="http://localhost:3000/api/mp/oauth/callback"
# Optional HMAC key for the OAuth state token; falls back to MP_OAUTH_CLIENT_SECRET if unset.
MP_OAUTH_STATE_SECRET=""
# 32-byte hex key to encrypt stored MP tokens at rest, e.g. `openssl rand -hex 32`.
MP_TOKEN_ENC_KEY=""
# Tenant #1 id — fallback for unmapped/legacy webhooks during the single-tenant interim.
MP_FALLBACK_TENANT_ID=""

# ── M4: Fiscal Module (NFC-e) ────────────────────────────────────────────────
# Provider: FocusNFe (https://focusnfe.com.br) or PlugNotas (https://plugnotas.com.br)
FISCAL_API_URL="https://homologacao.focusnfe.com.br/v2"
FISCAL_API_TOKEN=""
FISCAL_WEBHOOK_SECRET=""

# Company data (required for NFC-e transmission)
FISCAL_COMPANY_NAME="Empresa Exemplo Ltda"
FISCAL_CNPJ="00000000000000"
FISCAL_IE="ISENTO"
FISCAL_STREET="Rua Exemplo"
FISCAL_NUMBER="100"
FISCAL_DISTRICT="Centro"
FISCAL_CITY="São Paulo"
FISCAL_STATE="SP"
FISCAL_ZIP="01310-100"
FISCAL_CITY_CODE="3550308"

# ── Evolution API (WhatsApp) ───────────────────────────────────────────────────
# Documentation: https://doc.evolution-api.com/v2/pt/integrations/cloudapi
# URL base da sua instância Evolution API (ex: https://api.seudominio.com)
EVOLUTION_API_URL="https://sua-instancia-evolution.com"
# Token de autenticação global da Evolution API
EVOLUTION_API_KEY="seu-token-global-aqui"
# Nome da instância WhatsApp criada na Evolution API
EVOLUTION_INSTANCE_NAME="pdv-zapflow"
# Token do webhook (opcional, para receber mensagens)
EVOLUTION_WEBHOOK_TOKEN=""

# ── Shipping / Logistics ──────────────────────────────────────────────────────
# Optional: external shipping API for real-time rate calculation
SHIPPING_API_URL=""
SHIPPING_API_TOKEN=""
# Store origin CEP (used for distance-based shipping calculation)
STORE_ORIGIN_CEP="01310-100"

# ── Customer Follow-up System (Retention) ─────────────────────────────────────
# Vercel sets CRON_SECRET automatically for cron jobs
CRON_SECRET=""
# Store name used in follow-up WhatsApp messages
STORE_NAME="Sua Loja"

# ── AI Support Chat ───────────────────────────────────────────────────────────
# Google Gemini API key for the floating support chat widget (Gemini Flash-Lite)
# Get yours at: https://aistudio.google.com/apikey
