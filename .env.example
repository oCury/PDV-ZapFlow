# ── Evolution API (WhatsApp) ───────────────────────────────────────────────────
# Documentation: https://doc.evolution-api.com/v2/pt/integrations/cloudapi
# URL base da sua instância Evolution API (ex: https://api.seudominio.com)
EVOLUTION_API_URL="https://sua-instancia-evolution.com"
# Token de autenticação global da Evolution API
EVOLUTION_API_KEY="seu-token-global-aqui"
# Nome da instância WhatsApp criada na Evolution API
EVOLUTION_INSTANCE_NAME="pdv-zapflow"
# Token do webhook (opcional, para receber mensagens)
EVOLUTION_WEBHOOK_TOKEN=""

# ── Shipping / Logistics ──────────────────────────────────────────────────────
