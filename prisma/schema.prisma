generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  plan          Plan?
  active        Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  mp_connection MpConnection?

  @@map("tenants")
}

model MpConnection {
  id                      String    @id @default(cuid())
  tenant_id               String    @unique
  mp_user_id              String
  access_token            String
  refresh_token           String
  public_key              String?
  scope                   String?
  token_type              String?
  live_mode               Boolean   @default(false)
  access_token_expires_at DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  tenant                  Tenant    @relation(fields: [tenant_id], references: [id])

  @@index([mp_user_id])
  @@map("mp_connections")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

// Lowercase values are intentional: they match planFromTenant()/Plan union in
// src/lib/entitlements.ts, avoiding a string-translation layer. Backfill + cast
// handled at rollout (see docs/superpowers/plans/2026-06-29-entitlements-layer.md Task 12).
enum Plan {
  basic
  pro
  enterprise
}

model User {
  id                   String               @id @default(cuid())
  tenant_id            String?
  name                 String
  email                String               @unique
  password             String
  role                 UserRole             @default(EMPLOYEE)
  active               Boolean              @default(true)
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  cash_register_shifts CashRegisterShift[]
  commission_rules     CommissionRule[]
  sales_goals          SalesGoal[]
  sales_as_seller      Sale[]              @relation("SellerSales")
  processed_exchanges  Exchange[]

  @@index([tenant_id])
  @@map("users")
}

// ─── Category (Hierarchical) ────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  tenant_id   String?
  name        String
  slug        String
  parent_id   String?
  image_url   String?
  sort_order  Int        @default(0)
  active      Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children           Category[]               @relation("CategoryTree")
  products           Product[]
  commission_rules   CommissionCategoryRule[]

  @@index([tenant_id])
  @@unique([tenant_id, slug])
  @@index([parent_id])
  @@index([slug])
  @@map("categories")
}

// ─── Product ────────────────────────────────────────────────────────────────

model Product {
  id             String           @id @default(cuid())
  tenant_id      String?
  name           String
  barcode        String
  cost_price     Decimal          @db.Decimal(10, 2)
  sell_price     Decimal          @db.Decimal(10, 2)
  stock_quantity Int              @default(0)
  min_stock      Int              @default(0)   // M2: alert threshold
  category       String           // legacy string category
  category_id    String?          // FK to Category model
  has_variants   Boolean          @default(false)
  image_url      String?
  // ── Fiscal fields ──
  ncm            String?          // NCM 8 dígitos
  cfop           String?          @default("5102")
  fiscal_unit    String?          @default("UN")
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  sale_items     SaleItem[]
  variants       ProductVariant[]
  category_rel   Category?        @relation(fields: [category_id], references: [id])

  @@unique([tenant_id, barcode])
  @@index([tenant_id])
  @@index([barcode])
  @@index([category])
  @@index([category_id])
  @@map("products")
}

// ─── Product Variant (SKU: Tamanho + Estampa/Cor/Modelo) ────────────────────

model ProductVariant {
  id             String     @id @default(cuid())
  tenant_id      String?
  product_id     String
  sku            String
  size           String     // P, M, G, GG, etc.
  color          String?    // cor ou estampa
  model          String?    // modelo específico
  barcode        String?
  stock_quantity Int        @default(0)
  min_stock      Int        @default(0)
  cost_price     Decimal?   @db.Decimal(10, 2) // override do produto base
  sell_price     Decimal?   @db.Decimal(10, 2) // override do produto base
  image_url      String?
  active         Boolean    @default(true)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  product        Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sale_items     SaleItem[]

  @@unique([tenant_id, sku])
  @@unique([tenant_id, barcode])
  @@index([tenant_id])
  @@index([product_id])
  @@index([sku])
  @@index([size])
  @@map("product_variants")
}

// ─── Payment / Sale enums ───────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  CARD
  PIX
  LOYALTY // M3: loyalty points as payment
  VOUCHER // M6: vale-troca / vale-presente
}

enum CommissionType {
  FIXED_PERCENT     // % fixa sobre valor da venda
  CATEGORY_PERCENT  // % variável por categoria
  TIERED            // escalonada por faixa de faturamento
}

// ─── Exchange enums ─────────────────────────────────────────────────────────

enum ExchangeStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum ExchangeReason {
  WRONG_SIZE
  DEFECT
  DISLIKE
  OTHER
}

enum ExchangeItemAction {
  RETURN     // devolução pura (crédito)
  EXCHANGE   // troca por outro item
}

// ─── Voucher enums ──────────────────────────────────────────────────────────

enum VoucherType {
  EXCHANGE   // gerado por troca
  GIFT       // vale-presente comprado
}

enum VoucherStatus {
  ACTIVE
  USED       // totalmente utilizado
  EXPIRED
  CANCELLED
}

enum SaleStatus {
  OPEN      // M5: table/command order being built
  PENDING   // payment pending
  APPROVED  // legacy completed sale
  COMPLETED // M5: explicitly finished
  CANCELLED // M5: cancelled order
}

enum DeliveryStatus {
  PENDING     // aguardando preparo
  READY       // pronto para envio
  DISPATCHED  // saiu para entrega
  DELIVERED   // entregue
  FAILED      // tentativa falhou
  CANCELLED   // cancelada
}

// ─── Customer (CRM) ─────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  tenant_id      String?
  name           String?
  email          String?  // M3
  phone          String
  whatsapp       String?
  cpf            String?  // M3: Brazilian CPF
  loyalty_points Int      @default(0) // M3: 1 BRL = 1 point
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  sales          Sale[]
  followups      CustomerFollowup[]
  vouchers       Voucher[]

  @@unique([tenant_id, email])
  @@unique([tenant_id, phone])
  @@unique([tenant_id, cpf])
  @@index([tenant_id])
  @@index([phone])
  @@index([cpf])
  @@map("customers")
}

// ─── Table (M5) ─────────────────────────────────────────────────────────────

model Table {
  id         String   @id @default(cuid())
  tenant_id  String?
  number     Int
  name       String?  // e.g. "Mesa Terraço"
  capacity   Int      @default(4)
  whatsapp   String?  // WhatsApp para avisos e cobrança
  status     String   @default("AVAILABLE") // AVAILABLE | OCCUPIED
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  sales      Sale[]

  @@unique([tenant_id, number])
  @@index([tenant_id])
  @@index([status])
  @@map("tables")
}

// ─── Sale ────────────────────────────────────────────────────────────────────

model Sale {
  id               String        @id @default(cuid())
  tenant_id        String?
  total_amount     Decimal       @db.Decimal(10, 2)
  payment_method   PaymentMethod @default(CASH)
  status           SaleStatus    @default(PENDING)
  customer_id      String?
  table_id         String?       // M5
  seller_id        String?       // vendedor que realizou a venda
  loyalty_discount Decimal?      @db.Decimal(10, 2) // M3: points used as discount
  notes            String?       // M5: order notes
  // ── Shipping / Logistics ──────────────────────────────────────────────────
  shipping_cost    Decimal?      @db.Decimal(10, 2)
  shipping_method  String?       // "CORREIOS", "TRANSPORTADORA", "MOTOBOY", "RETIRADA", etc.
  shipping_address String?       // endereço de entrega (JSON ou texto)
  shipping_cep     String?       // CEP de destino
  // ── Online checkout ───────────────────────────────────────────────────────
  payment_link     String?       // link de pagamento gerado
  channel          String        @default("PDV") // PDV, ONLINE, WHATSAPP
  // ── NFC-e fields ──
  nfce_status      String?       // "pending", "authorized", "error", "cancelled", "contingency"
  nfce_access_key  String?       // chave de acesso 44 dígitos
  nfce_qr_url      String?       // URL do QR code
  nfce_danfe_url   String?       // URL do PDF DANFE
  nfce_protocol    String?       // número do protocolo
  nfce_number      Int?          // número sequencial da nota
  nfce_series      Int?          @default(1)
  nfce_errors      String?       // JSON com erros da SEFAZ
  created_at       DateTime      @default(now())
  items            SaleItem[]
  payments         SalePayment[]
  customer         Customer?         @relation(fields: [customer_id], references: [id])
  table            Table?            @relation(fields: [table_id], references: [id]) // M5
  seller           User?             @relation("SellerSales", fields: [seller_id], references: [id])
  followup         CustomerFollowup?
  delivery         Delivery?
  fiscal_queue     FiscalQueue?
  fiscal_events    FiscalEvent[]
  exchanges        Exchange[]
  voucher_usages   VoucherUsage[]
  terminal_charges TerminalCharge[]

  @@index([tenant_id])
  @@index([table_id])
  @@index([seller_id])
  @@index([status])
  @@index([channel])
  @@index([created_at])
  @@map("sales")
}

model SalePayment {
  id                 String        @id @default(cuid())
  tenant_id          String?
  sale_id            String
  payment_method     PaymentMethod
  amount             Decimal       @db.Decimal(10, 2)
  created_at         DateTime      @default(now())
  terminal_charge_id String?
  installments       Int?
  card_brand         String?
  mp_payment_id      String?

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([sale_id])
  @@map("sale_payments")
}

enum TerminalOperatingMode {
  PDV
  STANDALONE
}

enum TerminalStatus {
  ONLINE
  OFFLINE
  BUSY
  UNKNOWN
}

enum TerminalChargeMethod {
  CREDIT
  DEBIT
  PIX
}

enum TerminalChargeStatus {
  CREATED
  SENT
  PROCESSING
  APPROVED
  DECLINED
  CANCELED
  ERROR
  EXPIRED
}

model PaymentTerminal {
  id             String                @id @default(cuid())
  tenant_id      String?
  name           String
  mp_device_id   String
  operating_mode TerminalOperatingMode @default(PDV)
  status         TerminalStatus        @default(UNKNOWN)
  location_label String?
  is_active      Boolean               @default(true)
  last_seen_at   DateTime?
  created_at     DateTime              @default(now())

  charges TerminalCharge[]

  @@unique([tenant_id, mp_device_id])
  @@index([tenant_id])
  @@index([is_active])
  @@map("payment_terminals")
}

model TerminalCharge {
  id            String               @id @default(cuid())
  tenant_id     String?
  sale_id       String?
  terminal_id   String
  mp_order_id   String
  mp_payment_id String?
  amount        Decimal              @db.Decimal(10, 2)
  method        TerminalChargeMethod
  installments  Int                  @default(1)
  status        TerminalChargeStatus @default(CREATED)
  error_code    String?
  created_at    DateTime             @default(now())
  resolved_at   DateTime?

  terminal PaymentTerminal @relation(fields: [terminal_id], references: [id])
  sale     Sale?           @relation(fields: [sale_id], references: [id])

  @@unique([tenant_id, mp_order_id])
  @@index([tenant_id])
  @@index([terminal_id])
  @@index([sale_id])
  @@index([status])
  @@map("terminal_charges")
}

model CashRegisterShift {
  id           String    @id @default(cuid())
  tenant_id    String?
  opened_at    DateTime  @default(now())
  closed_at    DateTime?
  opening_cash Decimal   @db.Decimal(10, 2)
  closing_cash Decimal?  @db.Decimal(10, 2)
  withdrawals  Decimal   @default(0) @db.Decimal(10, 2)
  user_id      String
  status       String    @default("OPEN") // OPEN | CLOSED

  user User @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([status])
  @@map("cash_register_shifts")
}

model SaleItem {
  id         String  @id @default(cuid())
  tenant_id  String?
  sale_id    String
  product_id String
  variant_id String? // FK to ProductVariant (SKU-level stock)
  quantity   Int
  unit_price Decimal @db.Decimal(10, 2)
  size       String? // snapshot do tamanho vendido
  color      String? // snapshot da cor/estampa vendida

  sale           Sale            @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [product_id], references: [id])
  variant        ProductVariant? @relation(fields: [variant_id], references: [id])
  exchange_items ExchangeItem[]

  @@index([tenant_id])
  @@index([sale_id])
  @@index([product_id])
  @@index([variant_id])
  @@map("sale_items")
}

// ─── Customer Follow-up (Retention) ──────────────────────────────────────────

model CustomerFollowup {
  id              String   @id @default(cuid())
  tenant_id       String?
  customer_id     String
  sale_id         String   @unique
  type            String   // "15_DAY_CASHBACK"
  cashback_amount Decimal  @db.Decimal(10, 2)
  points_added    Int
  sent_at         DateTime @default(now())
  whatsapp_status String   // "SENT", "FAILED", "PENDING"
  message         String?

  customer Customer @relation(fields: [customer_id], references: [id])
  sale     Sale     @relation(fields: [sale_id], references: [id])

  @@index([tenant_id])
  @@index([customer_id])
  @@index([sale_id])
  @@index([sent_at])
  @@map("customer_followups")
}

// ─── Store Settings (Key-Value) ─────────────────────────────────────────────

model StoreSettings {
  id         String   @id @default(cuid())
  tenant_id  String?
  key        String
  value      String
  updated_at DateTime @updatedAt

  @@unique([tenant_id, key])
  @@index([tenant_id])
  @@map("store_settings")
}

// ─── Commission (F4) ────────────────────────────────────────────────────────

model CommissionRule {
  id              String                  @id @default(cuid())
  tenant_id       String?
  user_id         String
  type            CommissionType
  default_percent Decimal                 @db.Decimal(5, 2)
  active          Boolean                 @default(true)
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt
  user            User                    @relation(fields: [user_id], references: [id])
  category_rules  CommissionCategoryRule[]
  tiers           CommissionTier[]

  @@index([tenant_id])
  @@index([user_id])
  @@map("commission_rules")
}

model CommissionCategoryRule {
  id                 String         @id @default(cuid())
  tenant_id          String?
  commission_rule_id String
  category_id        String
  percent            Decimal        @db.Decimal(5, 2)
  commission_rule    CommissionRule @relation(fields: [commission_rule_id], references: [id], onDelete: Cascade)
  category           Category      @relation(fields: [category_id], references: [id])

  @@unique([commission_rule_id, category_id])
  @@index([tenant_id])
  @@map("commission_category_rules")
}

model CommissionTier {
  id                 String         @id @default(cuid())
  tenant_id          String?
  commission_rule_id String
  min_revenue        Decimal        @db.Decimal(10, 2)
  max_revenue        Decimal?       @db.Decimal(10, 2)
  percent            Decimal        @db.Decimal(5, 2)
  commission_rule    CommissionRule @relation(fields: [commission_rule_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([commission_rule_id])
  @@map("commission_tiers")
}

model SalesGoal {
  id         String   @id @default(cuid())
  tenant_id  String?
  user_id    String
  period     String   // "DAILY", "WEEKLY", "MONTHLY"
  target     Decimal  @db.Decimal(10, 2)
  start_date DateTime
  end_date   DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id, start_date, end_date])
  @@map("sales_goals")
}

// ─── Fiscal Queue & Events (F1) ─────────────────────────────────────────────

model FiscalQueue {
  id         String   @id @default(cuid())
  tenant_id  String?
  sale_id    String   @unique
  payload    String   // JSON do NfcePayload
  attempts   Int      @default(0)
  last_error String?
  status     String   @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  sale       Sale     @relation(fields: [sale_id], references: [id])

  @@index([tenant_id])
  @@index([status])
  @@map("fiscal_queue")
}

model FiscalEvent {
  id         String   @id @default(cuid())
  tenant_id  String?
  sale_id    String
  event_type String   // "transmitted", "authorized", "error", "cancelled", "retry"
  payload    String?  // JSON de contexto
  created_at DateTime @default(now())
  sale       Sale     @relation(fields: [sale_id], references: [id])

  @@index([tenant_id])
  @@index([sale_id])
  @@index([created_at])
  @@map("fiscal_events")
}

model FiscalSequence {
  id          String  @id @default(cuid())
  tenant_id   String?
  series      Int     @default(1)
  last_number Int     @default(0)

  @@unique([tenant_id, series])
  @@index([tenant_id])
  @@map("fiscal_sequences")
}

// ─── Exchanges / Returns (F2) ───────────────────────────────────────────────

model Exchange {
  id               String             @id @default(cuid())
  tenant_id        String?
  original_sale_id String
  status           ExchangeStatus     @default(PENDING)
  reason           ExchangeReason
  reason_detail    String?
  total_returned   Decimal            @db.Decimal(10, 2)
  credit_generated Decimal?           @db.Decimal(10, 2)
  voucher_id       String?
  refund_method    String?            // "VOUCHER", "CASH", "ORIGINAL_METHOD"
  processed_by     String?
  nfce_return_key  String?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  original_sale    Sale               @relation(fields: [original_sale_id], references: [id])
  voucher          Voucher?           @relation(fields: [voucher_id], references: [id])
  items            ExchangeItem[]
  processor        User?              @relation(fields: [processed_by], references: [id])

  @@index([tenant_id])
  @@index([original_sale_id])
  @@index([status])
  @@map("exchanges")
}

model ExchangeItem {
  id               String             @id @default(cuid())
  tenant_id        String?
  exchange_id      String
  original_item_id String
  action           ExchangeItemAction
  quantity         Int
  unit_price       Decimal            @db.Decimal(10, 2)
  exchange         Exchange           @relation(fields: [exchange_id], references: [id], onDelete: Cascade)
  original_item    SaleItem           @relation(fields: [original_item_id], references: [id])

  @@index([tenant_id])
  @@index([exchange_id])
  @@map("exchange_items")
}

// ─── Vouchers / Gift Cards (F3) ─────────────────────────────────────────────

model Voucher {
  id             String        @id @default(cuid())
  tenant_id      String?
  code           String
  type           VoucherType
  original_value Decimal       @db.Decimal(10, 2)
  balance        Decimal       @db.Decimal(10, 2)
  status         VoucherStatus @default(ACTIVE)
  customer_id    String?
  expires_at     DateTime
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  customer       Customer?     @relation(fields: [customer_id], references: [id])
  exchanges      Exchange[]
  usages         VoucherUsage[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([code])
  @@index([customer_id])
  @@index([status, expires_at])
  @@map("vouchers")
}

model VoucherUsage {
  id         String   @id @default(cuid())
  tenant_id  String?
  voucher_id String
  sale_id    String
  amount     Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now())
  voucher    Voucher  @relation(fields: [voucher_id], references: [id])
  sale       Sale     @relation(fields: [sale_id], references: [id])

  @@index([tenant_id])
  @@index([voucher_id])
  @@index([sale_id])
  @@map("voucher_usages")
}

// ─── Delivery (Entregas) ──────────────────────────────────────────────────────

model Delivery {
  id              String         @id @default(cuid())
  tenant_id       String?
  sale_id         String?        @unique // 1:1 with Sale (null = manual delivery)
  status          DeliveryStatus @default(PENDING)
  carrier         String         @default("MANUAL") // MANUAL | MOTOBOY | CORREIOS | TRANSPORTADORA | NINETYNINE
  external_id     String? // carrier ride/shipment id (e.g. 99 ride id)
  tracking_code   String?
  tracking_url    String?
  recipient_name  String? // snapshot, independent of later customer edits
  recipient_phone String?
  address         String?
  cep             String?
  fee             Decimal?       @db.Decimal(10, 2) // seeded from sale.shipping_cost
  driver_name     String? // for motoboy / 99
  driver_phone    String?
  notes           String?
  dispatched_at   DateTime?
  delivered_at    DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  sale Sale? @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([status])
  @@index([carrier])
  @@map("deliveries")
}
