generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

model User {
  id                   String               @id @default(cuid())
  name                 String
  email                String               @unique
  password             String
  role                 UserRole             @default(EMPLOYEE)
  active               Boolean              @default(true)
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  cash_register_shifts CashRegisterShift[]

  @@map("users")
}

// ─── Category (Hierarchical) ────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parent_id   String?
  image_url   String?
  sort_order  Int        @default(0)
  active      Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parent_id])
  @@index([slug])
  @@map("categories")
}

// ─── Product ────────────────────────────────────────────────────────────────

model Product {
  id             String           @id @default(cuid())
  name           String
  barcode        String           @unique
  cost_price     Decimal          @db.Decimal(10, 2)
  sell_price     Decimal          @db.Decimal(10, 2)
  stock_quantity Int              @default(0)
  min_stock      Int              @default(0)   // M2: alert threshold
  category       String           // legacy string category
  category_id    String?          // FK to Category model
  has_variants   Boolean          @default(false)
  image_url      String?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  sale_items     SaleItem[]
  variants       ProductVariant[]
  category_rel   Category?        @relation(fields: [category_id], references: [id])

  @@index([barcode])
  @@index([category])
  @@index([category_id])
  @@map("products")
}

// ─── Product Variant (SKU: Tamanho + Estampa/Cor/Modelo) ────────────────────

model ProductVariant {
  id             String     @id @default(cuid())
  product_id     String
  sku            String     @unique
  size           String     // P, M, G, GG, etc.
  color          String?    // cor ou estampa
  model          String?    // modelo específico
  barcode        String?    @unique
  stock_quantity Int        @default(0)
  min_stock      Int        @default(0)
  cost_price     Decimal?   @db.Decimal(10, 2) // override do produto base
  sell_price     Decimal?   @db.Decimal(10, 2) // override do produto base
  image_url      String?
  active         Boolean    @default(true)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  product        Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sale_items     SaleItem[]

  @@index([product_id])
  @@index([sku])
  @@index([size])
  @@map("product_variants")
}

// ─── Payment / Sale enums ───────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  CARD
  PIX
  LOYALTY // M3: loyalty points as payment
}

enum SaleStatus {
  OPEN      // M5: table/command order being built
  PENDING   // payment pending
  APPROVED  // legacy completed sale
  COMPLETED // M5: explicitly finished
  CANCELLED // M5: cancelled order
}

// ─── Customer (CRM) ─────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  name           String?
  email          String?  @unique  // M3
  phone          String   @unique
  whatsapp       String?
  cpf            String?  @unique  // M3: Brazilian CPF
  loyalty_points Int      @default(0) // M3: 1 BRL = 1 point
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  sales          Sale[]
  followups      CustomerFollowup[]

  @@index([phone])
  @@index([cpf])
  @@map("customers")
}

// ─── Table (M5) ─────────────────────────────────────────────────────────────

model Table {
  id         String   @id @default(cuid())
  number     Int      @unique
  name       String?  // e.g. "Mesa Terraço"
  capacity   Int      @default(4)
  whatsapp   String?  // WhatsApp para avisos e cobrança
  status     String   @default("AVAILABLE") // AVAILABLE | OCCUPIED
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  sales      Sale[]

  @@index([status])
  @@map("tables")
}

// ─── Sale ────────────────────────────────────────────────────────────────────

model Sale {
  id               String        @id @default(cuid())
  total_amount     Decimal       @db.Decimal(10, 2)
  payment_method   PaymentMethod @default(CASH)
  status           SaleStatus    @default(PENDING)
  customer_id      String?
  table_id         String?       // M5
  loyalty_discount Decimal?      @db.Decimal(10, 2) // M3: points used as discount
  notes            String?       // M5: order notes
  // ── Shipping / Logistics ──────────────────────────────────────────────────
  shipping_cost    Decimal?      @db.Decimal(10, 2)
  shipping_method  String?       // "CORREIOS", "TRANSPORTADORA", "MOTOBOY", "RETIRADA", etc.
  shipping_address String?       // endereço de entrega (JSON ou texto)
  shipping_cep     String?       // CEP de destino
  // ── Online checkout ───────────────────────────────────────────────────────
  payment_link     String?       // link de pagamento gerado
  channel          String        @default("PDV") // PDV, ONLINE, WHATSAPP
  created_at       DateTime      @default(now())
  items            SaleItem[]
  payments         SalePayment[]
  customer         Customer?     @relation(fields: [customer_id], references: [id])
  table            Table?        @relation(fields: [table_id], references: [id]) // M5
  followup         CustomerFollowup?

  @@index([table_id])
  @@index([status])
  @@index([channel])
  @@map("sales")
}

model SalePayment {
  id             String        @id @default(cuid())
  sale_id        String
  payment_method PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  created_at     DateTime      @default(now())

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@index([sale_id])
  @@map("sale_payments")
}

model CashRegisterShift {
  id           String    @id @default(cuid())
  opened_at    DateTime  @default(now())
  closed_at    DateTime?
  opening_cash Decimal   @db.Decimal(10, 2)
  closing_cash Decimal?  @db.Decimal(10, 2)
  withdrawals  Decimal   @default(0) @db.Decimal(10, 2)
  user_id      String
  status       String    @default("OPEN") // OPEN | CLOSED

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([status])
  @@map("cash_register_shifts")
}

model SaleItem {
  id         String  @id @default(cuid())
  sale_id    String
  product_id String
  variant_id String? // FK to ProductVariant (SKU-level stock)
  quantity   Int
  unit_price Decimal @db.Decimal(10, 2)
  size       String? // snapshot do tamanho vendido
  color      String? // snapshot da cor/estampa vendida

  sale    Sale            @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])

  @@index([sale_id])
  @@index([product_id])
  @@index([variant_id])
  @@map("sale_items")
}

// ─── Customer Follow-up (Retention) ──────────────────────────────────────────

model CustomerFollowup {
  id              String   @id @default(cuid())
  customer_id     String
  sale_id         String   @unique
  type            String   // "15_DAY_CASHBACK"
  cashback_amount Decimal  @db.Decimal(10, 2)
  points_added    Int
  sent_at         DateTime @default(now())
  whatsapp_status String   // "SENT", "FAILED", "PENDING"
  message         String?

  customer Customer @relation(fields: [customer_id], references: [id])
  sale     Sale     @relation(fields: [sale_id], references: [id])

  @@index([customer_id])
  @@index([sale_id])
  @@index([sent_at])
  @@map("customer_followups")
}

// ─── Store Settings (Key-Value) ─────────────────────────────────────────────

model StoreSettings {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt

  @@map("store_settings")
}
